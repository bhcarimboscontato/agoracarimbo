---
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import CookieConsent from "@components/ui/CookieConsent.astro";
import SeoHead from "@components/seo/SeoHead.astro";
import { brandAssets } from "@data/site";
import { consentStorageKey, consentVersion } from "@data/consent";
import {
  getLocalBusinessSchema,
  getOrganizationSchema,
  getWebPageSchema,
  getWebSiteSchema
} from "@lib/seo";
import "@styles/global.css";

type Props = {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
};

const { title, description, canonicalPath, noindex = false, structuredData = [] } = Astro.props;
const organizationSchema = getOrganizationSchema();
const webSiteSchema = getWebSiteSchema();
const webPageSchema = getWebPageSchema({ title, description, canonicalPath });
const localBusinessSchema = getLocalBusinessSchema();
const schemas = [organizationSchema, webSiteSchema, localBusinessSchema, webPageSchema, ...structuredData];
const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? "";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
    />

<!-- Google tag (gtag.js) com modo de consentimento: nada de cookie de anúncio/medição antes do aceite. -->
<script is:inline define:vars={{ consentStorageKey, consentVersion, ga4MeasurementId }}>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function gtag(){window.dataLayer.push(arguments);};
  window.gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "denied",
    wait_for_update: 500
  });

  try {
    const stored = JSON.parse(window.localStorage.getItem(consentStorageKey) || "null");
    if (stored && stored.version === consentVersion) {
      const marketing = stored.marketing ? "granted" : "denied";
      window.gtag("consent", "update", {
        ad_storage: marketing,
        ad_user_data: marketing,
        ad_personalization: marketing,
        analytics_storage: stored.analytics ? "granted" : "denied"
      });
    }
  } catch (error) {
    // Sem acesso ao localStorage: segue com tudo negado.
  }

  window.gtag("js", new Date());
  window.gtag("config", "AW-11538800483");
  if (ga4MeasurementId) window.gtag("config", ga4MeasurementId);

  window.gtag_report_conversion = function (url) {
    let done = false;
    const callback = function () {
      if (done) return;
      done = true;
      if (typeof url !== "undefined") {
        window.location = url;
      }
    };

    window.gtag("event", "conversion", {
      send_to: "AW-11538800483/GKFtCMKMvb4aEOO-kP4q",
      value: 2.0,
      currency: "BRL",
      event_callback: callback
    });

    setTimeout(callback, 800);
    return false;
  };
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-11538800483"></script>
<script>
  import "@lib/tracking";
</script>

    <link rel="icon" href={brandAssets.favicon} sizes="any" />
    <link rel="apple-touch-icon" href={brandAssets.appleTouchIcon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {schemas.map((schema) => <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
