---
import SectionHeader from "@components/home/SectionHeader.astro";
import StampMark from "@components/blog/StampMark.astro";
import { blogIndex, blogPosts } from "@data/blogPosts";

const featuredPosts = blogPosts.slice(0, 3);
---

<section class="home-section home-section--light blog-teaser" aria-label="Guias do blog">
  <div class="container">
    <div class="blog-teaser__head">
      <SectionHeader
        eyebrow="Guias rápidos"
        title="Tire a dúvida antes de pedir"
        description="O que colocar no carimbo, qual modelo escolher e quanto tempo leva, explicado sem enrolação."
      />
      <a class="blog-teaser__all" href={blogIndex.path}>Ver todos os guias</a>
    </div>

    <div class="blog-teaser__grid">
      {featuredPosts.map((post, index) => (
        <a class="blog-teaser__card" href={post.path}>
          <StampMark text={post.stampMark} size="sm" tilt={index % 2 === 0 ? -6 : 5} />
          <span class="blog-teaser__category">{post.category}</span>
          <strong>{post.title}</strong>
          <span class="blog-teaser__time">{post.readingMinutes} min de leitura</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .blog-teaser__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .blog-teaser__all {
    margin-bottom: var(--space-8);
    color: var(--color-orange-800);
    font-weight: var(--font-weight-bold);
  }

  .blog-teaser__grid {
    display: grid;
    gap: var(--space-5);
  }

  .blog-teaser__card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    color: var(--color-black);
    text-decoration: none;
    background: var(--color-white);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .blog-teaser__card:hover {
    border-color: var(--color-orange-600);
    transform: translateY(-2px);
  }

  .blog-teaser__card :global(.stamp-mark) {
    justify-self: start;
    margin-bottom: var(--space-3);
  }

  .blog-teaser__category {
    color: var(--color-orange-800);
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .blog-teaser__card strong {
    font-size: 1.08rem;
    line-height: 1.3;
  }

  .blog-teaser__time {
    color: var(--color-gray-500);
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .blog-teaser__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-teaser__card {
      transition: none;
    }
  }
</style>
